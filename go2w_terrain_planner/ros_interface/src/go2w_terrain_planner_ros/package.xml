<?xml version="1.0"?>
<package format="2">
  <name>go2w_terrain_planner_ros</name>
  <version>0.1.0</version>
  <description>ROS1 TensorRT deployment adapter for the Go2W terrain planner.</description>

  <maintainer email="allgo@example.com">allgo</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>diagnostic_msgs</depend>
